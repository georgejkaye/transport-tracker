# Run with repo root as context

FROM oven/bun:1-alpine AS base

FROM base AS deps

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY client/package.json client/bun.lock ./

RUN bun install --frozen-lockfile

FROM georgejkaye/postgres-codegen:latest AS codegen

WORKDIR /app

COPY db/code code

RUN poetry run python src/postgrescodegen/main.py code output api.db

FROM python:3.13-bookworm AS openapi-py

RUN wget https://github.com/GitTools/GitVersion/releases/download/6.8.2/gitversion-linux-x64-6.8.2.tar.gz
RUN tar -xvf gitversion-linux-x64-6.8.2.tar.gz
RUN mv gitversion /usr/bin/

ARG POETRY_VERSION

RUN pip install poetry==${POETRY_VERSION}

WORKDIR /app

COPY api/pyproject.toml api/poetry.lock ./
RUN touch README.md

RUN poetry install --without dev --no-root

COPY api/src /app/src
COPY --from=codegen /app/output/db /app/src/api/db

RUN poetry install

ARG VERSION

RUN poetry run python src/api/api/openapi.py /app/openapi.json

FROM base AS openapi-ts

WORKDIR /app

COPY --from=openapi-py /app/openapi.json /app/openapi.json

RUN bunx openapi-typescript /app/openapi.json -o /app/api.d.ts

FROM base AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY client/package.json .
COPY client/next.config.mjs .
COPY client/next-env.d.ts .
COPY client/postcss.config.mjs .
COPY client/tailwind.config.ts .
COPY client/tsconfig.json .
COPY client/src ./src
COPY --from=openapi-ts /app/api.d.ts src/app/api/

ARG API_HOST
ENV API_HOST=${API_HOST}

ARG API_PROTOCOL
ENV API_PROTOCOL=${API_PROTOCOL}

ARG MAPTILER_KEY
ENV NEXT_PUBLIC_MAPTILER_KEY=${MAPTILER_KEY}

RUN bun run build

FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# COPY --from=builder /app/public ./public

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV NEXT_SHARP_PATH=/app/node_modules/sharp

ENV HOSTNAME="0.0.0.0"
ARG CLIENT_PORT
ENV PORT=${CLIENT_PORT}

CMD ["node", "server.js"]