FROM node:22-alpine

ARG CLIENT_PORT
ENV CLIENT_PORT=${CLIENT_PORT}

ARG API_HOST
ENV API_HOST=${API_HOST}

ARG API_PROTOCOL
ENV API_PROTOCOL=${API_PROTOCOL}

WORKDIR /app
COPY ./package.json .
COPY ./yarn.lock .
COPY ./next.config.mjs .
COPY ./postcss.config.mjs .
COPY ./tailwind.config.ts .
COPY ./tsconfig.json .
RUN yarn
CMD yarn dev -p ${CLIENT_PORT}